# syntax=docker/dockerfile:1.7
###############################################################################
# XLevelUp Engine — Dockerfile حرفه‌ای، مخصوص Railway
# نسخه اصلاح‌شده: بدون cache mount (سازگاری بیشتر با builder ریلوی)
# و با نسخه‌ی Xray پین‌شده (بدون وابستگی به GitHub API در هر build)
###############################################################################

ARG XRAY_VERSION="v25.5.16"
ARG BUILD_SHA="unknown"
ARG BUILD_DATE="unknown"

# ---------- Stage 1: دریافت باینری Xray-core از ریلیز رسمی ----------
FROM alpine:3.20 AS xray-fetch
ARG XRAY_VERSION

RUN apk add --no-cache curl unzip ca-certificates && \
    echo "==> در حال دانلود Xray-core نسخه: ${XRAY_VERSION}" && \
    curl -fL -o /tmp/xray.zip \
        "https://github.com/XTLS/Xray-core/releases/download/${XRAY_VERSION}/Xray-linux-64.zip" && \
    unzip -q /tmp/xray.zip -d /tmp/xray && \
    mv /tmp/xray/xray /usr/local/bin/xray && \
    chmod +x /usr/local/bin/xray && \
    rm -rf /tmp/xray /tmp/xray.zip && \
    echo "${XRAY_VERSION}" > /xray-version.txt

# ---------- Stage 2: وابستگی‌های Node ----------
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install --omit=dev --no-audit --no-fund

# ---------- Stage 3: ایمیج نهایی ----------
FROM node:20-alpine AS runtime
ARG BUILD_SHA
ARG BUILD_DATE

LABEL org.opencontainers.image.title="XLevelUp Engine" \
      org.opencontainers.image.revision="${BUILD_SHA}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.description="Xray-core + Panel API روی Railway"

RUN apk add --no-cache tini wget ca-certificates openssl && \
    addgroup -S xlevelup && adduser -S xlevelup -G xlevelup && \
    mkdir -p /etc/xray /data/xray-certs && \
    chown -R xlevelup:xlevelup /etc/xray /data /app 2>/dev/null || true

WORKDIR /app

COPY --from=xray-fetch /usr/local/bin/xray /usr/local/bin/xray
COPY --from=xray-fetch /xray-version.txt /xray-version.txt
COPY --from=deps /app/node_modules ./node_modules

COPY package.json ./
COPY panel-api.js ./
COPY xray-config.json ./xray-config.json
COPY entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh /usr/local/bin/xray && \
    chown -R xlevelup:xlevelup /app /etc/xray /data

USER xlevelup
ENV NODE_ENV=production
ENV CERT_DIR=/data/xray-certs

EXPOSE 8080
EXPOSE 10001 10002 10003

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -qO- "http://127.0.0.1:${PORT:-8080}/health" || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/entrypoint.sh"]
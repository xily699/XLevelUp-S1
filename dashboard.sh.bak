#!/data/data/com.termux/files/usr/bin/bash
# XLevelUp Auto-Deploy — داشبورد تعاملی
set -uo pipefail
BASE_DIR="$HOME/.xlevelup-deploy"
CONF_FILE="$BASE_DIR/config.env"
PID_FILE="$BASE_DIR/watcher.pid"
LOG_FILE="$BASE_DIR/logs/deploy.log"

[ -f "$CONF_FILE" ] || { echo "ابتدا setup.sh را اجرا کنید."; exit 1; }
# shellcheck disable=SC1090
source "$CONF_FILE"

C_G="\e[32m"; C_R="\e[31m"; C_Y="\e[33m"; C_C="\e[36m"; C_N="\e[0m"; C_B="\e[1m"
W=50

status_watcher(){
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
    echo -e "${C_G}● فعال${C_N} (PID $(cat "$PID_FILE"))"
  else
    echo -e "${C_R}● متوقف${C_N}"
  fi
}

line(){ printf '═%.0s' $(seq 1 "$W"); }

draw(){
  clear
  echo -e "${C_C}${C_B}╔$(line)╗${C_N}"
  printf "${C_C}${C_B}║${C_N}  %-*s${C_C}${C_B}║${C_N}\n" $((W-2)) "🚀 XLevelUp Auto-Deploy Dashboard"
  echo -e "${C_C}${C_B}╠$(line)╣${C_N}"
  printf "${C_C}║${C_N}  ریپازیتوری  : %-*s${C_C}║${C_N}\n" $((W-17)) "$GH_REPO ($GH_BRANCH)"
  printf "${C_C}║${C_N}  پوشه پروژه  : %-*s${C_C}║${C_N}\n" $((W-17)) "$(basename "$PROJECT_DIR")"
  printf "${C_C}║${C_N}  وضعیت واچر  : %-*b${C_C}║${C_N}\n" $((W-6)) "$(status_watcher)"
  LAST=$(tail -n1 "$LOG_FILE" 2>/dev/null || echo "—")
  printf "${C_C}║${C_N}  آخرین رویداد: %-*s${C_C}║${C_N}\n" $((W-17)) "${LAST:0:$((W-17))}"
  echo -e "${C_C}${C_B}╚$(line)╝${C_N}"
  echo
  echo -e "  ${C_Y}1)${C_N} شروع واچر پس‌زمینه     ${C_Y}2)${C_N} توقف واچر"
  echo -e "  ${C_Y}3)${C_N} دیپلوی فوری همین حالا  ${C_Y}4)${C_N} مشاهده لاگ زنده"
  echo -e "  ${C_Y}5)${C_N} ویرایش تنظیمات         ${C_Y}0)${C_N} خروج"
  echo
}

is_running(){ [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; }

while true; do
  draw
  read -rp "انتخاب شما: " CH
  case "$CH" in
    1)
      if is_running; then
        echo -e "${C_Y}واچر از قبل فعال است.${C_N}"
      else
        nohup bash "$BASE_DIR/supervisor.sh" >>"$BASE_DIR/logs/boot.log" 2>&1 &
        disown
        sleep 1
        echo -e "${C_G}واچر در پس‌زمینه شروع شد.${C_N}"
      fi
      sleep 1
      ;;
    2)
      pkill -f "supervisor.sh" 2>/dev/null
      pkill -f "watcher.sh" 2>/dev/null
      [ -f "$PID_FILE" ] && kill "$(cat "$PID_FILE")" 2>/dev/null
      rm -f "$PID_FILE"
      echo -e "${C_R}واچر متوقف شد.${C_N}"
      sleep 1
      ;;
    3)
      bash "$BASE_DIR/deploy.sh"
      read -rp "برای بازگشت، اینتر بزنید..." _
      ;;
    4)
      echo -e "${C_Y}(برای خروج از لاگ زنده، Ctrl+C را بزنید)${C_N}"
      sleep 1
      tail -n 40 -f "$LOG_FILE"
      ;;
    5)
      bash "$BASE_DIR/setup.sh"
      # shellcheck disable=SC1090
      source "$CONF_FILE"
      ;;
    0) exit 0 ;;
    *) ;;
  esac
done

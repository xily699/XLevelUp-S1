{
  "//": "XLevelUp Engine — کانفیگ سرور Xray روی Railway. سه اینباند مستقل روی سه پورت داخلی.",
  "//1": "vless+ws+tls  -> پشت Cloudflare Worker (فرانتینگ، مقاوم در برابر بلاک)",
  "//2": "vless+grpc+tls -> اتصال مستقیم فالبک (سریع‌تر وقتی فرانتینگ لازم نیست)",
  "//3": "vmess+ws+tls  -> پروتکل جایگزین سوم برای زمانی که VLESS شناسایی/بلاک بشه",

  "log": { "loglevel": "warning" },

  "api": {
    "tag": "api",
    "services": ["StatsService"]
  },
  "stats": {},
  "policy": {
    "levels": { "0": { "statsUserUplink": true, "statsUserDownlink": true } },
    "system": { "statsInboundUplink": true, "statsInboundDownlink": true }
  },

  "inbounds": [
    {
      "tag": "vless-ws-tls",
      "listen": "0.0.0.0",
      "port": 10001,
      "protocol": "vless",
      "settings": {
        "clients": [
          { "id": "41dca55b-7cbe-43a3-9915-0470cb7aca0a", "email": "user1@xlevelup", "level": 0 }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "certificates": [
            { "certificateFile": "/etc/xray/cert.pem", "keyFile": "/etc/xray/key.pem" }
          ]
        },
        "wsSettings": { "path": "/xvless", "headers": { "Host": "xlevelup-temp.up.railway.app" } }
      }
    },
    {
      "tag": "vless-grpc-tls",
      "listen": "0.0.0.0",
      "port": 10002,
      "protocol": "vless",
      "settings": {
        "clients": [
          { "id": "REPLACE-WITH-UUID-1", "email": "user1@xlevelup", "level": 0 }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "grpc",
        "security": "tls",
        "tlsSettings": {
          "certificates": [
            { "certificateFile": "/etc/xray/cert.pem", "keyFile": "/etc/xray/key.pem" }
          ]
        },
        "grpcSettings": { "serviceName": "xgrpc" }
      }
    },
    {
      "tag": "vmess-ws-tls",
      "listen": "0.0.0.0",
      "port": 10003,
      "protocol": "vmess",
      "settings": {
        "clients": [
          { "id": "REPLACE-WITH-UUID-2", "email": "user1-fallback@xlevelup", "level": 0 }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "certificates": [
            { "certificateFile": "/etc/xray/cert.pem", "keyFile": "/etc/xray/key.pem" }
          ]
        },
        "wsSettings": { "path": "/xvmess", "headers": { "Host": "xlevelup-temp.up.railway.app" } }
      }
    },
    {
      "tag": "api-in",
      "listen": "127.0.0.1",
      "port": 10085,
      "protocol": "dokodemo-door",
      "settings": { "address": "127.0.0.1" }
    }
  ],

  "outbounds": [
    { "tag": "direct", "protocol": "freedom" },
    { "tag": "block", "protocol": "blackhole" }
  ],

  "routing": {
    "rules": [
      { "type": "field", "inboundTag": ["api-in"], "outboundTag": "api" }
    ]
  }
}
